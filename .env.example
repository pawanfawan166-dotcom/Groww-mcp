# Use mock data when credentials are absent (default: 1)
GROWW_MOCK_MODE=1

# Option A: pre-generated access token
# GROWW_ACCESS_TOKEN=your_access_token

# Option B: TOTP flow (recommended — no daily approval)
# GROWW_API_KEY=your_api_key
# GROWW_TOTP_SECRET=your_base32_totp_secret

# Option C: API key + secret (requires daily approval on Groww)
# GROWW_API_KEY=your_api_key
# GROWW_API_SECRET=your_api_secret

# Option D: JSON blob (any of the fields above)
# GROWW_CREDENTIALS={"api_key":"...","totp_secret":"..."}
