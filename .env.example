# Groww-only by default (no Yahoo fallback). Set to 1 only for offline dev.
# GROWW_ALLOW_FALLBACK=0

# Option B: TOTP flow (recommended)
# GROWW_API_KEY=your_totp_token_from_groww
# GROWW_TOTP_SECRET=your_secret_key_from_groww

# Option A: pre-generated access token (expires daily ~6 AM IST)
# GROWW_ACCESS_TOKEN=your_access_token

# Option C: API key + secret (daily approval on Groww Cloud)
# GROWW_API_KEY=your_api_key
# GROWW_API_SECRET=your_api_secret

# Required for live market data + OI + option chain:
# → Active Trading API Subscription: https://groww.in/trade-api (₹499/month)
# → Static IP whitelisted: https://groww.in/trade-api/api-keys
